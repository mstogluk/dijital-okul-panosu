<Window x:Class="OkulPanosu.App.Views.ModuleSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modül Ayarları" Icon="/Assets/AppIcon.ico" Height="700" Width="1100" MinHeight="460" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" Background="{StaticResource BgPrimaryBrush}">
    <Grid Margin="20" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Modül Ayarları" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Başlık" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" Style="{StaticResource WatermarkTextBoxStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Vurgu Rengi" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeCombo" SelectedValuePath="Key">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="TypeSpecificPanel" />

        <Border Grid.Row="3" x:Name="ContentEditorHeader" Visibility="Collapsed"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Margin="0,12,0,10" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="ContentEditorHeaderText" Text="İçerik Ayarları" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Bu bölüm İçerikler menüsündeki sayfayla aynıdır — aşağıdaki 'Kaydet' butonu içeriği hemen paylaşılan veriye kaydeder."
                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="4" x:Name="ContentEditorHost" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="İptal" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Width="90" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
