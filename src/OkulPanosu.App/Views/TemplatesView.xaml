<UserControl x:Class="OkulPanosu.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="📋 Şablonlar" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="İçe Aktar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Import_Click" />
                <Button Content="+ Yeni Şablon" Style="{StaticResource PrimaryButtonStyle}" Click="NewTemplate_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TemplateList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <TextBox x:Name="RenameBox" Text="{Binding Name}" Width="220" Margin="0,0,8,0"
                                                 Style="{StaticResource WatermarkTextBoxStyle}"
                                                 Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                                        <Button Content="Ad Değiştir" Padding="10,4" Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="EditName_Click"
                                                Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="YAYINDA" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ModuleCountText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Yayına Al" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="Activate_Click" />
                                    <Button Content="Düzenle" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="EditModules_Click" />
                                    <Button Content="Kopyala" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Duplicate_Click" />
                                    <Button Content="Dışa Aktar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Export_Click" />
                                    <Button Content="Sil" Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
