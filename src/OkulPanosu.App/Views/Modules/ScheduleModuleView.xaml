<UserControl x:Class="OkulPanosu.App.Views.Modules.ScheduleModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14">
        <DockPanel>
            <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Style="{StaticResource HeadingStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" TextAlignment="Center" />

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       TextWrapping="Wrap" TextAlignment="Center" />

            <Grid x:Name="ContentPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="4,0,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SINIF" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Grid.Column="1" Text="DERS" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="ÖĞRETMEN" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="10" />
                        </Grid>
                        <ItemsControl x:Name="RowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ClassName}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Teacher}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="BreakOverlay" Background="{DynamicResource BreakOverlayBrush}" CornerRadius="8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="TENEFFÜS" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="BreakSubText" FontSize="13" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
