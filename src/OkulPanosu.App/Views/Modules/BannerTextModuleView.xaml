<UserControl x:Class="OkulPanosu.App.Views.Modules.BannerTextModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="18">
        <Grid x:Name="ContentGrid">
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Visibility="Collapsed" />
            <!--
                Viewbox, içeriğini SONSUZ genişlik varsayarak ölçer — bu yüzden doğrudan içine konan bir
                TextBlock'ta TextWrapping="Wrap" hiçbir zaman devreye girmez (her zaman tek satır ölçülüp
                sonra küçültülür). Çözüm: TextBlock'a AÇIKÇA bir genişlik (kapsayan Grid'in gerçek
                genişliği) vermek — böylece Viewbox onu O genişlikte ölçer, satır kaydırma o noktada
                devreye girer, gerekirse (satırlar sığmıyorsa) tüm blok orantılı küçültülür.
            -->
            <Viewbox x:Name="TextHost" Stretch="Uniform" StretchDirection="DownOnly">
                <TextBlock x:Name="BannerText" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Width="{Binding ActualWidth, ElementName=ContentGrid}" />
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
