<UserControl x:Class="OkulPanosu.App.Views.Modules.BirthdaysModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14">
        <DockPanel>
            <TextBlock x:Name="HeaderTextBlock" DockPanel.Dock="Top" Style="{StaticResource HeadingStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ClassText" Style="{StaticResource MutedTextStyle}" FontSize="15" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="DateText" Style="{StaticResource MutedTextStyle}" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
