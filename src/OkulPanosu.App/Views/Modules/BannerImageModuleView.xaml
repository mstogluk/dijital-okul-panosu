<UserControl x:Class="OkulPanosu.App.Views.Modules.BannerImageModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280"
                   TextAlignment="Center" Visibility="Collapsed" />
        <Image x:Name="PhotoImage" Stretch="Uniform" Visibility="Collapsed" />
    </Grid>
</UserControl>
