<UserControl x:Class="OkulPanosu.App.Views.Modules.CleanestClassModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14">
        <DockPanel>
            <TextBlock Text="🧹 Haftanın En Temiz Sınıfları" DockPanel.Dock="Top" Style="{StaticResource HeadingStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="RankText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8" />
                <TextBlock x:Name="ClassNameText" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ScoreText" Style="{StaticResource MutedTextStyle}" FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="AwardText" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
