<UserControl x:Class="OkulPanosu.App.Views.Modules.StudentOfMonthModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14">
        <DockPanel>
            <TextBlock Text="🏆 Ayın Örnek Öğrencisi" DockPanel.Dock="Top" Style="{StaticResource HeadingStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="150" Height="150" CornerRadius="75" ClipToBounds="True"
                            Background="{DynamicResource BgElevatedBrush}">
                        <Image x:Name="PhotoImage" Stretch="UniformToFill" />
                    </Border>
                </Viewbox>
                <TextBlock x:Name="NameText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ClassText" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,2,0,8" />
                <TextBlock x:Name="ReasonText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                <TextBlock x:Name="QuoteText" FontStyle="Italic" Style="{StaticResource MutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
