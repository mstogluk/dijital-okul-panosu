<UserControl x:Class="OkulPanosu.App.Views.Modules.DutyTeacherModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Nöbet yeri isminin SAĞINDA bir sütun olarak -->
        <DataTemplate x:Key="RosterItemRightTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
        <!-- Nöbet yeri isminin ALTINDA -->
        <DataTemplate x:Key="RosterItemBelowTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Label}" FontSize="11" Style="{StaticResource MutedTextStyle}" Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border Padding="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Grid.ColumnSpan="3" />

            <DockPanel x:Name="ListPanel">
                <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋 GÜNÜN NÖBET LİSTESİ" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="DayBadge" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
                <ListBox x:Name="RosterList" Margin="0,0,10,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Width="1" Margin="0,14,0,14" Background="{DynamicResource BorderBrush1}" />

            <StackPanel x:Name="PhotoPanel" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="150" Height="150" CornerRadius="75" ClipToBounds="True" HorizontalAlignment="Center"
                        Background="{DynamicResource BgElevatedBrush}" Margin="0,0,0,10">
                    <Image x:Name="PhotoImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="RoleText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="CurrentNameText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="CurrentBranchText" Style="{StaticResource MutedTextStyle}" FontSize="11"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
