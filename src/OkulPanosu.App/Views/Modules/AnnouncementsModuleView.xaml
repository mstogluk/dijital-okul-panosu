<UserControl x:Class="OkulPanosu.App.Views.Modules.AnnouncementsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="📢 Duyurular ve Haberler" Style="{StaticResource HeadingStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="PageText" Grid.Column="1" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <Grid x:Name="ContentHost" />
        </DockPanel>
    </Border>
</UserControl>
