<UserControl x:Class="OkulPanosu.App.Views.AnnouncementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="📢 Duyurular ve Haberler" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📂 Görsel Klasörünü Aç" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OpenImagesFolder_Click"
                        ToolTip="Kullanılmayan görselleri elle silmek için klasörü açar" />
                <Button Content="+ Duyuru Ekle" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="AddAnnouncement_Click" />
                <Button x:Name="SaveButton" Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Grid x:Name="TemplatePickerHost" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hangi Şablonda Düzenleniyor" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <ContentControl x:Name="TemplatePickerCombo" Grid.Column="1" />
            </Grid>
            <TextBlock Text="Duyuru içeriği (başlık/metin/görsel) TÜM şablonlarda ortaktır — sadece &quot;Bu şablonda&quot; kutucuğu, seçili şablonda gösterilip gösterilmeyeceğini belirler."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="14"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
        </StackPanel>

        <!--
            Sütun başlıkları BİLEREK ScrollViewer'ın DIŞINDA, kendi sabit satırında — önceden liste ile
            birlikte kayıp gidiyordu, kullanıcı birkaç kart aşağı indiğinde hangi sütunun ne işe
            yaradığını unutuyordu ("kutucukların ne işe yaradığı belli olmuyor").
        -->
        <Grid Grid.Row="2" Margin="8,10,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="DURUM" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
            <TextBlock Grid.Column="1" Text="BAŞLIK" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
            <TextBlock Grid.Column="2" Text="BAŞLANGIÇ" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
            <TextBlock Grid.Column="3" Text="BİTİŞ (opsiyonel)" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
            <TextBlock Grid.Column="4" Text="ÖNEM" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
            <TextBlock Grid.Column="6" Grid.ColumnSpan="2" Text="İŞLEMLER" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AnnouncementsList" />
        </ScrollViewer>
    </Grid>
</UserControl>
