<UserControl x:Class="OkulPanosu.App.Views.PersonnelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="👥 Personel &amp; Öğretmen Portföyü" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
        </Grid>
        <TextBlock Grid.Row="0" Text="Fotoğrafı olmayan personel/öğretmenler için otomatik olarak cinsiyete uygun bir silüet gösterilir."
                   Style="{StaticResource MutedTextStyle}" Margin="0,32,0,0" VerticalAlignment="Bottom" />

        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" MaxHeight="420">
            <StackPanel MaxWidth="1030" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Toplu Aktarım (Kopyala-Yapıştır)" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Excel'den personel listenizi kopyalayıp aşağıya yapıştırın. İlk satır başlık olmalı — Ad Soyad (ya da ayrı Adı/Soyadı) yeterli; Branş, Cinsiyet (Erkek/Kadın), Görev/Ünvan (ör. &quot;Öğretmen&quot;, &quot;Memur&quot;, &quot;Hizmetli&quot;) ve doğum tarihi (tek bir 'Doğum Tarihi' sütunu ya da ayrı 'Gün'/'Ay') hepsi opsiyonel — sırası önemli değil, başlıklardan otomatik bulunur. Bir Görev sütunu varsa her satır kendi göreviyle eklenir (metninde &quot;öğretmen&quot; geçmiyorsa otomatik &quot;Diğer Personel&quot; kategorisine girer); yoksa eski davranış korunur, tüm satırlar Öğretmen olur. Aynı isim tekrar eklenmez."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox x:Name="BulkImportBox" Style="{StaticResource WatermarkTextBoxStyle}" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" Height="90" />
                        <Button Content="+ Listeyi Sisteme Aktar" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="BulkImport_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Yeni Personel Tanımla" Style="{StaticResource HeadingStyle}" Margin="0,0,0,8" />
                        <StackPanel x:Name="NewPersonForm" />
                        <Button Content="+ Personel Ekle" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddPerson_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="ListHeader" Text="Tanımlı Personel Listesi (0)" Style="{StaticResource HeadingStyle}" Margin="0,14,0,10" />
                <Grid Margin="8,0,8,6" MaxWidth="1500" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="İSİM" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="KATEGORİ" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="BRANŞ" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="GÖREV" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="5" Text="CİNSİYET" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="6" Text="GÜN" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="7" Text="AY" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="8" Text="İŞLEMLER" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1500" HorizontalAlignment="Left">
                    <ItemsControl x:Name="PersonnelList" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
