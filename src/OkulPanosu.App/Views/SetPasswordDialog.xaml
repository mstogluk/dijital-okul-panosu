<Window x:Class="OkulPanosu.App.Views.SetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yönetici Şifresi Belirle" Icon="/Assets/AppIcon.ico" Height="260" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource BgPrimaryBrush}">
    <Grid Margin="18" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Yeni yönetici şifresi belirleyin" Style="{StaticResource HeadingStyle}" Margin="0,0,0,12" />

        <PasswordBox Grid.Row="1" x:Name="NewPasswordInput" Style="{StaticResource WatermarkPasswordBoxStyle}" Margin="0,0,0,8" />
        <PasswordBox Grid.Row="2" x:Name="ConfirmPasswordInput" Style="{StaticResource WatermarkPasswordBoxStyle}" />

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Width="80" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
