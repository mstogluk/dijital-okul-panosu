<UserControl x:Class="OkulPanosu.App.Views.VideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="🎬 Yerel Videolar &amp; Oynatma Çizelgesi" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🗂 Klasördeki Dosyalar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ToggleFolderPanel_Click" />
                <Button Content="+ Video Ekle" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="AddVideo_Click" />
                <Button x:Name="SaveButton" Content="Kaydet" Style="{StaticResource SecondaryButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="0" Text="Videolar internetten bağımsız, paylaşılan veri klasöründeki Medya\Videolar altından oynatılır." Style="{StaticResource MutedTextStyle}"
                   Margin="0,32,0,0" VerticalAlignment="Bottom" />

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Grid x:Name="TemplatePickerHost" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hangi Şablonun Videoları" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <ContentControl x:Name="TemplatePickerCombo" Grid.Column="1" />
            </Grid>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SuccessBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" FontSize="14"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

            <Border x:Name="FolderPanel" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="FolderPanelHeader" Text="Videolar Klasöründeki Dosyalar (0)" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="Artık hiçbir video kartında kullanılmayan dosyaları buradan tamamen silebilirsiniz — Windows Gezgini'ne (uzak PC'ye) gitmenize gerek kalmaz."
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel x:Name="FolderFilesList" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl x:Name="VideosList" />
        </ScrollViewer>
    </Grid>
</UserControl>
