<UserControl x:Class="OkulPanosu.App.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="🎓 Öğrenciler" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
        </Grid>
        <TextBlock Grid.Row="0" Text="Okulun genel öğrenci listesi — Doğum Günleri modülü panoda göstereceği kişileri buradan (doğum tarihine göre) okur."
                   Style="{StaticResource MutedTextStyle}" Margin="0,32,0,0" VerticalAlignment="Bottom" />

        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" MaxHeight="420">
            <StackPanel MaxWidth="960" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Toplu Aktarım (Kopyala-Yapıştır)" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="e-Okul veya Excel'den öğrenci listenizi kopyalayıp aşağıya yapıştırın. İlk satır başlık olmalı — Ad Soyad (ya da ayrı Adı/Soyadı) ve Sınıf sütunları yeterli; Cinsiyet (Erkek/Kadın, fotoğrafsız kayıtlarda otomatik silüet için) ve doğum tarihi (tek bir 'Doğum Tarihi' sütunu ya da ayrı 'Gün'/'Ay') opsiyoneldir. Sütunların sırası önemli değil, başlıklardan otomatik bulunur."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox x:Name="BulkImportBox" Style="{StaticResource WatermarkTextBoxStyle}" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" Height="90" />
                        <CheckBox x:Name="ReplaceAllCheck" Margin="0,10,0,0">
                            <TextBlock Text="Yapıştırmadan önce mevcut öğrenci listesini TAMAMEN sil (yeni öğretim yılı listesi)"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button Content="+ Listeyi Sisteme Aktar" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="BulkImport_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Yeni Öğrenci Ekle" Style="{StaticResource HeadingStyle}" Margin="0,0,0,10" />
                        <StackPanel x:Name="NewStudentForm" Orientation="Horizontal" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ListHeader" Grid.Column="0" Text="Öğrenci Listesi (0)" Style="{StaticResource HeadingStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="🔍 İsme göre ara" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource WatermarkTextBoxStyle}" TextChanged="SearchBox_TextChanged" />
                </Grid>
                <Grid Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="AD SOYAD" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="2" Text="SINIF" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="3" Text="GÜN" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="4" Text="AY" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="5" Text="CİNSİYET" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Grid.Column="6" Text="İŞLEMLER" Style="{StaticResource MutedTextStyle}" FontWeight="Bold" FontSize="11" />
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StudentsList" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
