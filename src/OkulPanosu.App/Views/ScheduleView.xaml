<UserControl x:Class="OkulPanosu.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="📖 Ders ve Zil Saatleri Ayarları" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Periyot Ekle" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="AddPeriod_Click" />
                <Button x:Name="SaveButton" Content="Değişiklikleri Kaydet" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="0" Text="Okuldaki günlük ders akışını, ders isimlerini ve zil saatlerini buradan düzenleyin."
                   Style="{StaticResource MutedTextStyle}" Margin="0,32,0,0" VerticalAlignment="Bottom" />

        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,14">
            <StackPanel>
                <TextBlock Text="Otomatik Oluştur" Style="{StaticResource HeadingStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Aşağıdaki değerlerle tüm periyotları baştan oluşturur — her periyot sonrasında girdiğiniz teneffüs süresi kadar ara verilir."
                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <StackPanel x:Name="GeneratorForm" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PeriodsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
