<Window x:Class="OkulPanosu.App.Views.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Okul Panosu - Yönetim" Icon="/Assets/AppIcon.ico" Height="820" Width="1300"
        WindowStartupLocation="Manual" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="200" MinWidth="0" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition x:Name="SubNavColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="🖥️ Okul Panosu" FontSize="15" FontWeight="Bold" Margin="14,16,10,16" />

                <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                    <Button x:Name="StartBoardButton" Content="📺 Yayını Başlat" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" Click="StartBoard_Click" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Ctrl+Alt+Y: yayını başlat/durdur" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Okul Panosu v0.1" />
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource NavListStyle}" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="15" Width="24" />
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BorderBrush1}" />
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush1}" Focusable="False" />
        <Button Grid.Column="1" x:Name="ToggleNavButton" Content="◀" Width="18" Height="36" Padding="0"
                VerticalAlignment="Top" Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}"
                Click="ToggleNav_Click" ToolTip="Menüyü daralt/genişlet" />

        <Border x:Name="SubNavBorder" Grid.Column="2" ClipToBounds="True" Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="İÇERİKLER" Style="{StaticResource MutedTextStyle}"
                           FontWeight="Bold" Margin="14,16,10,8" />
                <ListBox x:Name="SubNavList" Style="{StaticResource NavListStyle}" SelectionChanged="SubNavList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="15" Width="24" />
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="3" x:Name="MainContent" />
    </Grid>
</Window>
